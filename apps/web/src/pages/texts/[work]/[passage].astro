---
// apps/web/src/pages/texts/[work]/[passage].astro
// A single passage: server-rendered static HTML (readable with JS disabled).
// The data contract mirrors what the future API /bundle endpoint will serve —
// the island and agents read the SAME shape (frontend-architecture.md).
import ReaderLayout from "../../../layouts/ReaderLayout.astro";
import TranslationCompare from "../../../components/TranslationCompare.tsx";

interface Props {
  work: string;
  passage: string;
}

// Static paths for the PoC — later these come from the Atlas / API.
export async function getStaticPaths() {
  const samples = [
    { work: "kramasadbhava", passage: "1.2", sanskrit: "atha ko 'sau parameśvaraḥ", translations: [
        { id: "td-1", label: "A", text: "Now who is this supreme lord?" },
        { id: "td-2", label: "B", text: "Then, what is that highest īśvara?" },
      ] },
    { work: "kramasadbhava", passage: "1.3", sanskrit: "yad anuttaraṃ padaṃ", translations: [
        { id: "td-3", label: "A", text: "which is the unsurpassable abode" },
        { id: "td-4", label: "B", text: "that highest station" },
      ] },
  ];
  return samples.map((s) => ({ params: { work: s.work, passage: s.passage }, props: s }));
}

const { work, passage } = Astro.props;
const sanskrit = Astro.props.sanskrit;
const translations = Astro.props.translations;
---
<ReaderLayout title={`${work} · ${passage}`} work={work}>
  <p class="meta">{work} · {passage} · <span is:raw>server-rendered, no JS needed to read</span></p>
  <p class="sanskrit">{sanskrit}</p>
  <TranslationCompare translations={translations} client:visible />
</ReaderLayout>
