    {
      "gold_id": "ARG-GOLD-004",
      "title": "The Essence of Light: prak\u0101\u015ba vs vimar\u015ba (V2-H)",
      "passage_id": "pt:passage:ipvv:chunkV2-H-pancamo-vimarsa-k11-13.md",
      "chunk": "chunkV2-H-pancamo-vimarsa-k11-13",
      "propositions": [
        {
          "proposition_id": "G4-TC1",
          "text": "Manifestation (prak\u0101\u015ba) is not a passive, inert light; it shows the world.",
          "kind": "TEXTUAL_CLAIM",
          "explicitness": "TEXTUALLY_SUPPORTED",
          "speaker": "siddh\u0101nta",
          "primary_evidence": [
            {
              "passage_id": "pt:passage:ipvv:chunkV2-H-pancamo-vimarsa-k11-13.md",
              "span_id": "chunkV2-H-pancamo-vimarsa-k11-13:L9:T23",
              "lemma": "prak\u0101\u015bo",
              "role": "manifestation"
            }
          ]
        },
        {
          "proposition_id": "G4-CRYSTAL",
          "text": "A light that merely showed the world without knowing it would be no different from crystal \u2014 inert.",
          "kind": "TEXTUAL_CLAIM",
          "explicitness": "TEXTUALLY_SUPPORTED",
          "speaker": "siddh\u0101nta",
          "primary_evidence": [
            {
              "passage_id": "pt:passage:ipvv:chunkV2-H-pancamo-vimarsa-k11-13.md",
              "span_id": "chunkV2-H-pancamo-vimarsa-k11-13:L9:T63",
              "lemma": "bhedenaiva",
              "role": "distinctness in manifestation"
            }
          ]
        },
        {
          "proposition_id": "G4-DIST",
          "text": "Bare showing is distinct from self-aware manifesting; the mark is vimar\u015ba.",
          "kind": "TEXTUAL_CLAIM",
          "explicitness": "TEXTUALLY_SUPPORTED",
          "speaker": "siddh\u0101nta",
          "primary_evidence": [
            {
              "passage_id": "pt:passage:ipvv:chunkV2-H-pancamo-vimarsa-k11-13.md",
              "span_id": "chunkV2-H-pancamo-vimarsa-k11-13:L9:T66",
              "lemma": "bhedena hi par\u0101mar\u015be",
              "role": "self-aware reflection (vimar\u015ba)"
            }
          ]
        },
        {
          "proposition_id": "G4-TC2",
          "text": "The essence of light is the reflexive-awareness (vimar\u015ba) \u2014 light's own grasp of itself.",
          "kind": "TEXTUAL_CLAIM",
          "explicitness": "TEXTUALLY_SUPPORTED",
          "speaker": "siddh\u0101nta",
          "primary_evidence": [
            {
