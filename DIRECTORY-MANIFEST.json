{
  "$schema": "patala.directory-manifest.v1",
  "updated": "2026-08-14",
  "note": "Machine-verifiable classification of every top-level folder. Every folder resolves to: role, clean name, Layer, canonical/archive/coordination/scratch, and where an agent finds it. This is the deterministic map of the codebase \u2014 the physical folder names stay (renaming breaks ~20k imports); this is the trusted translation layer.",
  "role_legend": {
    "code": "production code (the spine)",
    "docs": "documentation / knowledge",
    "coordination": "agent/lane coordination",
    "assets": "data / artifacts / outputs",
    "scratch": "temporary / gitignored",
    "skill": "Hermes skill pack",
    "example": "runnable examples / executable truth"
  },
  "class_legend": {
    "CANONICAL": "the current source of truth for its role",
    "ARCHIVE": "superseded history \u2014 marked, do not follow",
    "COORDINATION": "live agent tracking (delegates authority to handover/)",
    "SCRATCH": "temporary, gitignored"
  },
