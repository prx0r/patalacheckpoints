{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://patala.local/source-evidence/docs/tools/MANIFEST.schema.json",
  "title": "Pāṭala S0.1 External-Tool Manifest",
  "description": "Machine-readable registry of the mature open infrastructure Pāṭala borrows (reuse-first doctrine). Validates source-evidence/docs/tools/MANIFEST.json.",
  "type": "object",
  "required": ["about", "category_order", "tools"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "about": { "type": "string" },
    "updated": { "type": "string" },
    "category_order": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "tools": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/tool"
      }
    }
  },
  "$defs": {
    "tool": {
      "type": "object",
      "required": ["category", "borrow", "license", "docs_url", "repo", "local_doc", "docs_cache"],
      "additionalProperties": false,
      "properties": {
        "category": { "type": "string", "enum": ["parsing", "bibliography", "retrieval", "annotation", "evaluation", "workflow", "packaging", "assistant", "watch"] },
        "borrow": { "type": "string" },
        "license": { "type": "string" },
        "docs_url": { "type": "string", "format": "uri" },
        "repo": { "type": "string", "format": "uri" },
        "local_doc": { "type": "string" },
        "docs_cache": { "type": "string" }
      }
    }
  }
}
