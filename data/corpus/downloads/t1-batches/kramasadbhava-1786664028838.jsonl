{"object_id": "kramasadbhava:b01508665", "verse": "aśarīrāḥ śarīrasthāḥ  kālyārādhanatatparāḥ  ||1/1"}
{"object_id": "kramasadbhava:bb8a72ce6", "verse": "svavimarśadaśanibhā  * * * * * * * *(?) ||1/ 2 ||"}
{"object_id": "kramasadbhava:b2f84c582", "verse": "vyomarūpā anantākhyā  aṣṭamūrtidharā śivā ||1/ 3 ||"}
{"object_id": "kramasadbhava:b7cf536b3", "verse": "pretatve saṃsthitā nityaṃ tasyā devyāstu sarvataḥ ||1/ 5 ||"}
{"object_id": "kramasadbhava:b8d721f56", "verse": "suśrūṣo  gaṅgado bhūtvā tasyārādhanatatparaḥ ||1/ 6 ||"}
{"object_id": "kramasadbhava:bcecf326c", "verse": "abravīt tu  samāsena bhairavo bhairavīṃ  tataḥ ||1/ 7 ||"}
{"object_id": "kramasadbhava:b5b8c7dc6", "verse": "namo'stu paramānande nirānande namo'stu te ||1/ 8 ||"}
{"object_id": "kramasadbhava:bf9293ac3", "verse": "namaḥ kuleśi kauleśi vijñānavibhave namaḥ ||1/ 9 ||"}
{"object_id": "kramasadbhava:b9ed32454", "verse": "namo māyādivaibhavyai viśvajṛmbhe  rakṣa me ||1/ 10 ||"}
{"object_id": "kramasadbhava:bff3afded", "verse": "namo'stu te mahāraudri  saumyarūpe namo'stu te ||1/ 11 ||"}
{"object_id": "kramasadbhava:bbe4dc3c8", "verse": "icchārūpasvabhāvasthe bhairaveśi namo'stu te ||1/ 12 ||"}
{"object_id": "kramasadbhava:beb2ace05", "verse": "kriyārūpe mahārūpe viśvarūpe namo'stu te ||1/ 13 ||"}
{"object_id": "kramasadbhava:b44b770d3", "verse": "bhāvābhāvavirāmānte sarvābhāve  namo'stu te ||1/ 14 ||"}
{"object_id": "kramasadbhava:be4be5387", "verse": "āhlādapadagarbhe tu vyāptirūpe  namo'stu te ||1/ 15 ||"}
{"object_id": "kramasadbhava:b29effce2", "verse": "nādarūpe mahānāde sādākhyāyai namo'stu te ||1/ 16 ||"}
{"object_id": "kramasadbhava:bdf8d8bd2", "verse": "śaktirūpe tu  dehasthe sarvāvasthe namo'stu * ||1/ 17 ||"}
{"object_id": "kramasadbhava:bfde3db7c", "verse": "śivarūpe mahāśānte śāntātīte namo'stu te ||1/ 18 ||"}
{"object_id": "kramasadbhava:b0a2ad082", "verse": "hṛtpadmakarṇikāntasthe  jvālārūpe  namo'stu te ||1/ 19 ||"}
{"object_id": "kramasadbhava:be6ed3f0d", "verse": "tālusthe tu mahākāli  sarvabhakṣye  namo'stu te ||1/ 20 ||"}
{"object_id": "kramasadbhava:b670873c6", "verse": "brahmadvāre  sthite  kāli vasturūpe  namo'stu te ||1/ 21 ||"}
