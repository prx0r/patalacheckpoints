{"work": "nadakarika", "verse_idx": 1, "source_sha256": "43159ceaac681a33d21bb99922e0a97811db184ff13115049fc972a979537596", "sanskrit": "śrīrāmakaṇṭharacitāṃ vyākhyāsye nādakārikām ||", "translation": "I will expound the Nādakārikā composed by the illustrious Rāmakaṇṭha.", "status": "MACHINE_PROPOSED", "ts": "2026-08-13T15:38:46"}
