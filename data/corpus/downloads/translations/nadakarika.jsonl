{"work": "nadakarika", "verse_idx": 6, "source_sha256": "d8c513b8960015d219d6dd6dc75b5b3d6c3b36af0267496b4ab052b0e421e098", "sanskrit": "ityādāvapi syāditi bhāvaḥ || 5 ||", "translation": "The intended sense is: 'so it may be also in cases like this'.", "status": "MACHINE_PROPOSED", "ts": "2026-08-13T15:38:46"}
