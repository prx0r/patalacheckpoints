{"work": "kaivalyaupanisad", "verse_idx": 10, "source_sha256": "6b79167e7702907eb63abd421e2abd41470ae7bed54c16a2dfd5a64c5b85fcf3", "sanskrit": "jñānanirmathanābhyāsāt pāpaṃ [pāśaṃ] dahati paṇḍitaḥ ||11||", "translation": "", "status": "OPEN", "ts": "2026-08-13T19:30:31"}
{"work": "kaivalyaupanisad", "verse_idx": 11, "source_sha256": "c3e23043f8c1f1883a98962b569b0e3296d7fe4cf775a40658a28c21eb366d04", "sanskrit": "striyannapānādivicitrabhogaiḥ sa eva jāgrat paritṛptim eti ||12||", "translation": "", "status": "OPEN", "ts": "2026-08-13T19:30:31"}
{"work": "kaivalyaupanisad", "verse_idx": 12, "source_sha256": "41c9e7e3c4843fe62595b0fa14176556f9e74c69eff8c5400ce870365aa2a7bf", "sanskrit": "suṣuptikāle sakale vilīne tamo 'bhibhūtaḥ sukharūpam eti ||13||", "translation": "", "status": "OPEN", "ts": "2026-08-13T19:30:31"}
{"work": "kaivalyaupanisad", "verse_idx": 13, "source_sha256": "6f920449ddb91196691f71aaace5a505fdb92aafdf8cd1e0450f9249907b6b14", "sanskrit": "puratraye krīḍati yaśca jīvas tatas tu jātaṃ sakalaṃ vicitram ||14||", "translation": "", "status": "OPEN", "ts": "2026-08-13T19:30:31"}
{"work": "kaivalyaupanisad", "verse_idx": 14, "source_sha256": "446e667ce04f1fbd7ec29f4ad96c253d54559cb5102c5a249f6646a011b9178a", "sanskrit": "dhāramānandam akhaṇḍabodhaṃ yasmiṃl layaṃ yāti puratrayaṃ ca ||14*||", "translation": "", "status": "OPEN", "ts": "2026-08-13T19:30:31"}
