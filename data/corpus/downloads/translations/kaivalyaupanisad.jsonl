{"work": "kaivalyaupanisad", "verse_idx": 16, "source_sha256": "b9feedc3b3e4b198a633c98ecd2b82ea56a39ac10e6d7a242eb2f9254e740916", "sanskrit": "sūkṣmāt sūkṣmataraṃ nityaṃ tat tvam eva tvam eva tat ||16||", "translation": "", "status": "OPEN", "ts": "2026-08-13T19:30:31"}
{"work": "kaivalyaupanisad", "verse_idx": 17, "source_sha256": "1ace23db7042f4737ec0f4f2811ae60cd6b16184522cbc0dca56d8c407c7b146", "sanskrit": "tad brahmāham iti jñātvā sarvabandhaiḥ pramucyate ||17||", "translation": "", "status": "OPEN", "ts": "2026-08-13T19:30:31"}
{"work": "kaivalyaupanisad", "verse_idx": 18, "source_sha256": "776267ecfceb93fb97f94b5d2163a697137a0132f4a53411f56bd02ae94e035e", "sanskrit": "tebhyo vilakṣaṇaḥ sākṣī cinmātro 'haṃ sadā śivaḥ ||18||", "translation": "", "status": "OPEN", "ts": "2026-08-13T19:30:31"}
{"work": "kaivalyaupanisad", "verse_idx": 19, "source_sha256": "b93808ba7da9ed1e1be3e0d77a47f0a7e74aa093d5f0c332f930ceeba853cb41", "sanskrit": "mayi sarvaṃl layaṃ yāti tad brahmādvayam asmy aham ||19||", "translation": "", "status": "OPEN", "ts": "2026-08-13T19:30:31"}
{"work": "kaivalyaupanisad", "verse_idx": 20, "source_sha256": "a829d7b38ba340aa82cf06dbf3b0b982da69139cbce6e6fd5550d5a89f26f10b", "sanskrit": "[iti] prathamaḥ khaṇḍaḥ ||", "translation": "", "status": "OPEN", "ts": "2026-08-13T19:30:31"}
{"work": "kaivalyaupanisad", "verse_idx": 21, "source_sha256": "fb21af654d65fd6803b4c7d823f2c253a1e6c7f1c444191afa078f457d8b820b", "sanskrit": "purātano 'haṃ puruṣo 'ham īśo hiraṇmayo 'haṃ śivarūpam asmi ||20||", "translation": "", "status": "OPEN", "ts": "2026-08-13T19:30:31"}
{"work": "kaivalyaupanisad", "verse_idx": 22, "source_sha256": "2e5af938f381f89f33e46cd104a8695d004b3fae20c8833a42bc889537ceedab", "sanskrit": "ahaṃ vijānāmi viviktarūpo na cāsti vettā mama cit sadāham ||21||", "translation": "", "status": "OPEN", "ts": "2026-08-13T19:30:31"}
{"work": "kaivalyaupanisad", "verse_idx": 23, "source_sha256": "ccfdc8fa690fb619353b8845f115c71559143ce1e461696cfba1fdd7207ba290", "sanskrit": "na puṇyapāpe mama nāsti nāśo na janma dehendriyabuddhir asti ||22||", "translation": "", "status": "OPEN", "ts": "2026-08-13T19:30:31"}
{"work": "kaivalyaupanisad", "verse_idx": 24, "source_sha256": "dd8f88971f6b7e9ac708d1ff9457e14b3bb4318aac187d124b42a453fc26fdb6", "sanskrit": "evaṃ viditvā paramātmarūpaṃ guhāśayaṃ niṣkalam advitīyam ||23||", "translation": "", "status": "OPEN", "ts": "2026-08-13T19:30:31"}
{"work": "kaivalyaupanisad", "verse_idx": 25, "source_sha256": "33c6bb65d6af6bb6c96e175433b20c775d4626c5080e6570415b067cf9ea04c8", "sanskrit": "samastasākṣiṃ sadasadvihīnaṃ prayāti śuddhaṃ paramātmarūpam ||23*||", "translation": "", "status": "OPEN", "ts": "2026-08-13T19:30:31"}
{"work": "kaivalyaupanisad", "verse_idx": 26, "source_sha256": "446fc0cb73b5b7ae9b39b1116efc8ebbd8c760ffbd7aa17bfde9ab1ef9a9ba92", "sanskrit": "ity atharvavede kaivalyopaniṣat samāptā ||", "translation": "", "status": "OPEN", "ts": "2026-08-13T19:30:31"}
{"work": "kaivalyaupanisad", "verse_idx": 0, "source_sha256": "094c15832421d6751ce411981552f51b7c3528fd81788a7019d8813c5accfc49", "sanskrit": "yathācirāt [yayācirāt] sarvapāpaṃ vyapohya parātparaṃ puruṣaṃ yāti vidvān ||1||", "translation": "The wise one, having quickly dispelled all sin, goes to the Person higher than the highest.", "status": "MACHINE_PROPOSED", "ts": "2026-08-13T21:25:50"}
{"work": "kaivalyaupanisad", "verse_idx": 1, "source_sha256": "adf553d7f817edb2d0d9eea1e0ac52fc04e3d250371e5d38bac6847f3603c884", "sanskrit": "na karmaṇā na prajayā dhanena tyāgenaike amṛtatvam ānaśuḥ ||2||", "translation": "Not by action, not by offspring, not by wealth — by renunciation alone some attained immortality.", "status": "MACHINE_PROPOSED", "ts": "2026-08-13T21:25:50"}
{"work": "kaivalyaupanisad", "verse_idx": 2, "source_sha256": "422c9b6a37292f4a28bf00628e7745bd2a2832a97cf5d0737ffbad98627453cc", "sanskrit": "vedānta-vijñānasuniścitārthāḥ saṃnyāsayogād yatayaḥ śuddhasattvāḥ ||3||", "translation": "Ascetics of pure being, whose aim is firmly settled by Vedānta-knowledge, [proceed] through the discipline of renunciation...", "status": "MACHINE_PROPOSED", "ts": "2026-08-13T21:25:50"}
{"work": "kaivalyaupanisad", "verse_idx": 3, "source_sha256": "aadc4bddf09b09556dc21e6b7e381ffe5b289b9506ce44d0f6b26da7939cc336", "sanskrit": "viviktadeśe ca sukhāsanasthaḥ śuciḥ samagrīvaśiraḥśarīraḥ ||4||", "translation": "And in a secluded place, seated in a comfortable posture, pure, with neck, head, and body held erect...", "status": "MACHINE_PROPOSED", "ts": "2026-08-13T21:25:50"}
{"work": "kaivalyaupanisad", "verse_idx": 4, "source_sha256": "57508610857592978f409505357a998237e9ae93d4e1f6cb5ee4df155a2cb72b", "sanskrit": "hṛtpuṇḍarīkaṃ virajaṃ viśuddhaṃ vicintya madhye viṣadam [viśadaṃ] viśokam ||5||", "translation": "Having contemplated in the middle [of it] the lotus of the heart — free from passion, pure, clear, sorrowless...", "status": "MACHINE_PROPOSED", "ts": "2026-08-13T21:25:50"}
{"work": "kaivalyaupanisad", "verse_idx": 5, "source_sha256": "cedd47953e2253c59eaa2760f45a0257c66651ded5b3b8e4b75cc82c52176449", "sanskrit": "tam ādimadhyāntavihīnam ekaṃ vibhuṃ cidānandam arūpam adbhutam ||6||", "translation": "[Contemplating] him, devoid of beginning, middle, and end, one, all-pervading, consciousness-bliss, formless, wondrous...", "status": "MACHINE_PROPOSED", "ts": "2026-08-13T21:25:50"}
{"work": "kaivalyaupanisad", "verse_idx": 6, "source_sha256": "ddcbeb67503c1943c9ec822e34155479c7729e27d8a0f8809670d52d03ef8ba3", "sanskrit": "dhyātvā munirgacchati bhūtayoniṃ samastasākṣiṃ tamasaḥ parastāt ||7||", "translation": "The sage, having meditated, goes to the source of beings, the witness of all, beyond darkness.", "status": "MACHINE_PROPOSED", "ts": "2026-08-13T21:25:50"}
{"work": "kaivalyaupanisad", "verse_idx": 7, "source_sha256": "6b75e85c917f2136bbb556dca9a0f31763fb16db9b812dd84a6d7c46fd535464", "sanskrit": "sa eva viṣṇuḥ sa prāṇaḥ sa kālo 'gniḥ sa candramāḥ ||8||", "translation": "He indeed is Viṣṇu; he is prāṇa; he is time; he is fire; he is the moon.", "status": "MACHINE_PROPOSED", "ts": "2026-08-13T21:25:50"}
{"work": "kaivalyaupanisad", "verse_idx": 8, "source_sha256": "d78bc760a58bca9144e4cc20c2166b4a9efbeaab7de33b5f082a3e80cbfd1d87", "sanskrit": "jñātvā taṃ mṛtyum atyeti nānyaḥ panthā vimuktaye ||9||", "translation": "Having known him, one goes beyond death; there is no other path for liberation.", "status": "MACHINE_PROPOSED", "ts": "2026-08-13T21:25:50"}
{"work": "kaivalyaupanisad", "verse_idx": 9, "source_sha256": "2bf8db893874cdf91c10268dc2cffc20d9d3cafcd7cf4822e28b45b9164d48f8", "sanskrit": "saṃpaśyan brahma paramaṃ yāti nānyena hetunā ||10||", "translation": "Beholding the highest Brahman, one goes [to it]; by no other means.", "status": "MACHINE_PROPOSED", "ts": "2026-08-13T21:25:50"}
{"work": "kaivalyaupanisad", "verse_idx": 10, "source_sha256": "6b79167e7702907eb63abd421e2abd41470ae7bed54c16a2dfd5a64c5b85fcf3", "sanskrit": "jñānanirmathanābhyāsāt pāpaṃ [pāśaṃ] dahati paṇḍitaḥ ||11||", "translation": "By the practice of churning knowledge, the wise man burns away sin [or: the bond].", "status": "MACHINE_PROPOSED", "ts": "2026-08-13T21:25:50"}
{"work": "kaivalyaupanisad", "verse_idx": 11, "source_sha256": "c3e23043f8c1f1883a98962b569b0e3296d7fe4cf775a40658a28c21eb366d04", "sanskrit": "striyannapānādivicitrabhogaiḥ sa eva jāgrat paritṛptim eti ||12||", "translation": "By the manifold enjoyments beginning with women, food, and drink, he indeed, while awake, attains full satisfaction.", "status": "MACHINE_PROPOSED", "ts": "2026-08-13T21:25:50"}
{"work": "kaivalyaupanisad", "verse_idx": 12, "source_sha256": "41c9e7e3c4843fe62595b0fa14176556f9e74c69eff8c5400ce870365aa2a7bf", "sanskrit": "suṣuptikāle sakale vilīne tamo 'bhibhūtaḥ sukharūpam eti ||13||", "translation": "", "status": "OPEN", "ts": "2026-08-13T21:25:50"}
{"work": "kaivalyaupanisad", "verse_idx": 13, "source_sha256": "6f920449ddb91196691f71aaace5a505fdb92aafdf8cd1e0450f9249907b6b14", "sanskrit": "puratraye krīḍati yaśca jīvas tatas tu jātaṃ sakalaṃ vicitram ||14||", "translation": "And the jīva who plays in the triad of cities — from that indeed all this variegated [world] is born.", "status": "MACHINE_PROPOSED", "ts": "2026-08-13T21:25:50"}
{"work": "kaivalyaupanisad", "verse_idx": 14, "source_sha256": "446e667ce04f1fbd7ec29f4ad96c253d54559cb5102c5a249f6646a011b9178a", "sanskrit": "dhāramānandam akhaṇḍabodhaṃ yasmiṃl layaṃ yāti puratrayaṃ ca ||14*||", "translation": "[He is] a stream of bliss, undivided awareness, in whom the triad of cities, too, goes to dissolution.", "status": "MACHINE_PROPOSED", "ts": "2026-08-13T21:25:50"}
{"work": "kaivalyaupanisad", "verse_idx": 15, "source_sha256": "b5b361f6f6315f3c2492abe018d0685988d0db3ad12e334ce55fdc437151cd26", "sanskrit": "khaṃ vāyur jyotir āpaḥ pṛthivī viśvasya dhāriṇī ||15||", "translation": "Space, wind, light, waters, earth — the sustainer of all.", "status": "MACHINE_PROPOSED", "ts": "2026-08-13T21:25:50"}
{"work": "kaivalyaupanisad", "verse_idx": 16, "source_sha256": "b9feedc3b3e4b198a633c98ecd2b82ea56a39ac10e6d7a242eb2f9254e740916", "sanskrit": "sūkṣmāt sūkṣmataraṃ nityaṃ tat tvam eva tvam eva tat ||16||", "translation": "More subtle than the subtle, eternal: that indeed are you; you indeed are that.", "status": "MACHINE_PROPOSED", "ts": "2026-08-13T21:25:50"}
{"work": "kaivalyaupanisad", "verse_idx": 17, "source_sha256": "1ace23db7042f4737ec0f4f2811ae60cd6b16184522cbc0dca56d8c407c7b146", "sanskrit": "tad brahmāham iti jñātvā sarvabandhaiḥ pramucyate ||17||", "translation": "Having known 'That — I am Brahman' thus, one is released from all bonds.", "status": "MACHINE_PROPOSED", "ts": "2026-08-13T21:25:50"}
{"work": "kaivalyaupanisad", "verse_idx": 18, "source_sha256": "776267ecfceb93fb97f94b5d2163a697137a0132f4a53411f56bd02ae94e035e", "sanskrit": "tebhyo vilakṣaṇaḥ sākṣī cinmātro 'haṃ sadā śivaḥ ||18||", "translation": "Different from them, the witness, pure consciousness — I am always Śiva.", "status": "MACHINE_PROPOSED", "ts": "2026-08-13T21:25:50"}
{"work": "kaivalyaupanisad", "verse_idx": 19, "source_sha256": "b93808ba7da9ed1e1be3e0d77a47f0a7e74aa093d5f0c332f930ceeba853cb41", "sanskrit": "mayi sarvaṃl layaṃ yāti tad brahmādvayam asmy aham ||19||", "translation": "In me all goes to dissolution; I am that non-dual Brahman.", "status": "MACHINE_PROPOSED", "ts": "2026-08-13T21:25:50"}
{"work": "kaivalyaupanisad", "verse_idx": 20, "source_sha256": "a829d7b38ba340aa82cf06dbf3b0b982da69139cbce6e6fd5550d5a89f26f10b", "sanskrit": "[iti] prathamaḥ khaṇḍaḥ ||", "translation": "Thus [ends] the first section (khaṇḍa).", "status": "MACHINE_PROPOSED", "ts": "2026-08-13T21:25:50"}
{"work": "kaivalyaupanisad", "verse_idx": 21, "source_sha256": "fb21af654d65fd6803b4c7d823f2c253a1e6c7f1c444191afa078f457d8b820b", "sanskrit": "purātano 'haṃ puruṣo 'ham īśo hiraṇmayo 'haṃ śivarūpam asmi ||20||", "translation": "I am the ancient one; I am the Person; I am the Lord; I am the golden one; I am of the form of Śiva.", "status": "MACHINE_PROPOSED", "ts": "2026-08-13T21:25:50"}
{"work": "kaivalyaupanisad", "verse_idx": 22, "source_sha256": "2e5af938f381f89f33e46cd104a8695d004b3fae20c8833a42bc889537ceedab", "sanskrit": "ahaṃ vijānāmi viviktarūpo na cāsti vettā mama cit sadāham ||21||", "translation": "I know, being of distinct form; and there is no knower of me — I am always consciousness.", "status": "MACHINE_PROPOSED", "ts": "2026-08-13T21:25:50"}
{"work": "kaivalyaupanisad", "verse_idx": 23, "source_sha256": "ccfdc8fa690fb619353b8845f115c71559143ce1e461696cfba1fdd7207ba290", "sanskrit": "na puṇyapāpe mama nāsti nāśo na janma dehendriyabuddhir asti ||22||", "translation": "For me there is no merit and sin, no destruction, no birth, no body, senses, or intellect.", "status": "MACHINE_PROPOSED", "ts": "2026-08-13T21:25:50"}
{"work": "kaivalyaupanisad", "verse_idx": 24, "source_sha256": "dd8f88971f6b7e9ac708d1ff9457e14b3bb4318aac187d124b42a453fc26fdb6", "sanskrit": "evaṃ viditvā paramātmarūpaṃ guhāśayaṃ niṣkalam advitīyam ||23||", "translation": "Having thus known the form of the Supreme Self, dwelling in the cave, partless, without a second...", "status": "MACHINE_PROPOSED", "ts": "2026-08-13T21:25:50"}
{"work": "kaivalyaupanisad", "verse_idx": 25, "source_sha256": "33c6bb65d6af6bb6c96e175433b20c775d4626c5080e6570415b067cf9ea04c8", "sanskrit": "samastasākṣiṃ sadasadvihīnaṃ prayāti śuddhaṃ paramātmarūpam ||23*||", "translation": "He goes to the pure form of the Supreme Self, the witness of all, devoid of being and non-being.", "status": "MACHINE_PROPOSED", "ts": "2026-08-13T21:25:50"}
{"work": "kaivalyaupanisad", "verse_idx": 26, "source_sha256": "446fc0cb73b5b7ae9b39b1116efc8ebbd8c760ffbd7aa17bfde9ab1ef9a9ba92", "sanskrit": "ity atharvavede kaivalyopaniṣat samāptā ||", "translation": "Thus, in the Atharvaveda, the Kaivalya Upaniṣad is completed.", "status": "MACHINE_PROPOSED", "ts": "2026-08-13T21:25:50"}
{"work": "kaivalyaupanisad", "verse_idx": 24, "source_sha256": "41c9e7e3c4843fe62595b0fa14176556f9e74c69eff8c5400ce870365aa2a7bf", "sanskrit": "suṣuptikāle sakale vilīne tamo 'bhibhūtaḥ sukharūpam eti ||13||", "translation": "", "status": "OPEN", "ts": "2026-08-13T22:22:03"}
